# Replace the example hostname and certificate paths with real values.
server {
    listen 80;
    server_name ai.example.edu.cn;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name ai.example.edu.cn;
    ssl_certificate /etc/letsencrypt/live/ai.example.edu.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ai.example.edu.cn/privkey.pem;
    client_max_body_size 21m;
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 90s;
    }
}
