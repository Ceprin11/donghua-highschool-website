+// Stream shards into one buffer; avoid retaining a second full model copy.
+export async function fetchAndMergeChunks(urls, signal) {
+  const manifestResponse = await fetch(new URL('./manifest.json', new URL(urls[0], location.href)), { signal });
+  if (!manifestResponse.ok) throw new Error('模型分片清单无法读取');
+  const { sizes } = await manifestResponse.json();
+  const mergedArray = new Uint8Array(sizes.reduce((sum, size) => sum + size, 0));
+  let offset = 0;
+  for (let index = 0; index < urls.length; index++) {
+    const response = await fetch(urls[index], { signal });
