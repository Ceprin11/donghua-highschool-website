# Node 24.15 or newer in the Node 24 LTS line. Do not expose these as VITE_*.
NODE_ENV=development
PORT=3001
# Relative to project root, contains SQLite and private uploads. Never public/dist.
DATA_DIR=./data
# Development uses the Vite browser origin. Production must use your HTTPS origin.
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Leave empty for local development. Compose uses one trusted local proxy hop.
TRUST_PROXY=
