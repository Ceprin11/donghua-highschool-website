{
  "name": "SiteSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "default": "default"
    },
    "site_name": {
      "type": "string",
      "default": "\u4eba\u5de5\u667a\u80fd\u79d1\u666e\u8bfe\u7a0b\u4e0e\u4e92\u52a8\u5b9e\u9a8c\u5ba4"
    },
    "school_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "\u4e1c\u534e\u5927\u5b66",
        "\u4e1c\u534e\u5927\u5b66\u9644\u5c5e\u677e\u6c5f\u9ad8\u7ea7\u4e2d\u5b66"
      ]
    },
    "logo_asset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "hero_title": {
      "type": "string",
      "default": "\u770b\u89c1\u4eba\u5de5\u667a\u80fd\u7684\u539f\u7406\uff0c\u63a2\u7d22\u672a\u6765\u4e16\u754c\u7684\u53ef\u80fd"
    },
    "hero_description": {
      "type": "string",
      "default": "\u4ece\u8ba4\u8bc6\u4eba\u5de5\u667a\u80fd\uff0c\u5230\u7406\u89e3\u673a\u5668\u5982\u4f55\u611f\u77e5\u3001\u751f\u6210\u4e0e\u884c\u52a8\u3002\u901a\u8fc7\u8bfe\u7a0b\u8bb2\u89e3\u4e0e\u4e92\u52a8\u5b9e\u9a8c\uff0c\u8ba9\u62bd\u8c61\u7684 AI \u77e5\u8bc6\u53d8\u5f97\u53ef\u89c2\u5bdf\u3001\u53ef\u5c1d\u8bd5\u3002"
    },
    "hero_media_asset_id": {
      "type": "string",
      "default": ""
    },
    "project_intro": {
      "type": "string",
      "default": ""
    },
    "teaching_features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "about_text": {
      "type": "string",
      "default": ""
    },
    "contact_email": {
      "type": "string",
      "default": ""
    },
    "footer_text": {
      "type": "string",
      "default": ""
    },
    "filing_info": {
      "type": "string",
      "default": ""
    },
    "section_visibility": {
      "type": "object",
      "properties": {
        "themes": {
          "type": "boolean",
          "default": true
        },
        "teacher": {
          "type": "boolean",
          "default": true
        },
        "experiments": {
          "type": "boolean",
          "default": true
        },
        "works": {
          "type": "boolean",
          "default": true
        },
        "activities": {
          "type": "boolean",
          "default": true
        }
      },
      "default": {}
    },
    "featured_experiment_slugs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "featured_work_slugs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "published"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}