{
  "name": "StudentWork",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "default": ""
    },
    "theme_slug": {
      "type": "string",
      "default": ""
    },
    "work_type": {
      "type": "string",
      "enum": [
        "project",
        "image",
        "video",
        "interactive"
      ],
      "default": "project"
    },
    "author_display_name": {
      "type": "string",
      "default": ""
    },
    "ai_knowledge": {
      "type": "string",
      "default": ""
    },
    "creative_highlights": {
      "type": "string",
      "default": ""
    },
    "cover_asset_id": {
      "type": "string",
      "default": ""
    },
    "cover_image_url": {
      "type": "string",
      "default": ""
    },
    "image_asset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "video_asset_id": {
      "type": "string",
      "default": ""
    },
    "demo_url": {
      "type": "string",
      "default": ""
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    }
  },
  "required": [
    "slug",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}