{
  "name": "QuizQuestion",
  "type": "object",
  "properties": {
    "experiment_slug": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "single",
        "truefalse"
      ],
      "default": "single"
    },
    "question": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ]
      },
      "default": []
    },
    "correct_option_id": {
      "type": "string",
      "default": ""
    },
    "explanation": {
      "type": "string",
      "default": ""
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    }
  },
  "required": [
    "experiment_slug",
    "question"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}